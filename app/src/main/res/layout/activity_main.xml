<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Torima Auto" android:textSize="24sp" android:layout_marginTop="0dp" />
    <TextView android:id="@+id/debugStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="アクセシビリティ：未接続" />
    <Button android:id="@+id/startCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="操作バーを表示してトリマを開く" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="トリマの操作バーで「開始」「停止」「学習・報告」を選べます。" android:textSize="14sp" android:layout_marginTop="0dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="回収状況" android:textSize="18sp" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/collectionOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:text="回収タスク：実行記録なし" android:textIsSelectable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="診断を送る" android:textSize="18sp" android:layout_marginTop="10dp" />
    <Button android:id="@+id/sendDriveDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Driveに診断を送る" />
    <TextView android:id="@+id/driveDiagnosticStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="操作報告もここから送れます。送信後、このチャットに「送った」と伝えてください。" />
    <Button android:id="@+id/sharingToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="ほかの共有方法・保存先" />
    <LinearLayout android:id="@+id/sharingPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="8dp">
      <Button android:id="@+id/shareAllDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:text="共有メニューで診断を送る（ZIP）" />
      <Button android:id="@+id/changeDriveDiagnosticTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Driveの保存先を変更" />
    </LinearLayout>
    <Button android:id="@+id/settingsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="設定・更新" />
    <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="8dp">
      <Button android:id="@+id/openSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="アクセシビリティ設定を開く" />
      <Button android:id="@+id/stopCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="操作バーを閉じる" />
      <Button android:id="@+id/checkUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="アプリの更新を確認" />
      <TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更新確認待ち" android:textIsSelectable="true" />
      <Switch android:id="@+id/enableHomeRecovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:text="HOMEで進めないとき自動で復旧を試す" />
      <Switch android:id="@+id/fastAdMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="高速実験：広告終了後の待機を省略" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ガチャなどの遷移で誤操作が出る場合は高速実験をOFFにしてください。" android:textSize="14sp" android:layout_marginTop="0dp" />
    </LinearLayout>
    <Button android:id="@+id/learningToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="広告・HOMEの学習を管理" />
    <LinearLayout android:id="@+id/learningPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="8dp">
      <Button android:id="@+id/manageLearnedRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学習した操作を個別にON／OFF" />
      <Button android:id="@+id/copyLearnedRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学習した操作をコピー" />
      <Button android:id="@+id/clearLearnedRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="広告・HOMEの学習をすべて削除…" />
      <Button android:id="@+id/clearLegacyPending" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="古い保留例だけ削除…" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="マップなどの登録は操作バーの「学習・報告」から確認できます。" android:textSize="14sp" android:layout_marginTop="0dp" />
    </LinearLayout>
    <Button android:id="@+id/advancedToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="詳細な記録・テスト" />
    <LinearLayout android:id="@+id/advancedPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="8dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="個別の記録" android:textSize="16sp" android:layout_marginTop="0dp" />
      <TextView android:id="@+id/homeExperimentInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="HOME押し方：成功した方式はまだ未記録" android:textIsSelectable="true" />
      <Button android:id="@+id/copyCollectionHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="回収タスク・所要時間の履歴をコピー" />
      <Button android:id="@+id/copyActionHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="操作履歴をコピー" />
      <Button android:id="@+id/copyCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="収集ログをまとめてコピー" />
      <TextView android:id="@+id/visualDiagnosticsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="画像記録：0枚" />
      <Button android:id="@+id/shareVisualDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="画像診断をZIPで共有（画像＋座標JSON）" />
      <Button android:id="@+id/copyVisualDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="画像診断の検出結果だけコピー" />
      <Button android:id="@+id/clearVisualDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存した画像診断を削除" />
      <Button android:id="@+id/clearCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="収集ログを消去" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HOME・広告の個別テスト" android:textSize="16sp" android:layout_marginTop="8dp" />
      <Button android:id="@+id/checkHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME判定（タップなし）" />
      <Button android:id="@+id/tapHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME判定＋1回だけタップ" />
      <Button android:id="@+id/runSequence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME→広告の×を閉じる（1回）" />
      <Button android:id="@+id/stopSequence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="広告待機を停止" />
      <Button android:id="@+id/scanAd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15秒後に広告診断（タップなし）" />
      <Button android:id="@+id/scanAdTap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15秒後に広告診断＋識別した×を1回タップ" />
      <Button android:id="@+id/copyResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="診断結果をコピー" />
      <TextView android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="診断待ち" android:textIsSelectable="true" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
