<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Torima Auto v3.10" android:textSize="23sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="10dp" android:text="診断を送るなら、このボタン1つだけでOK。"
 android:textStyle="bold" android:textSize="16sp"/>
<Button android:id="@+id/shareAllDiagnostics" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:minHeight="58dp"
 android:text="診断をまとめて共有（ZIP 1個）"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="トリマHOMEの自動試行後、操作バーの『指で押す比較（18秒）』を使います。指と自動の違い、CLICKイベント、画像をZIP1個にまとめます。自動→指→共有の順で操作してください。"
 android:paddingBottom="8dp"/>
<Switch android:id="@+id/fastAdMode"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:minHeight="52dp"
 android:text="高速実験：広告終了後の保護・待機をOFF（初期ON）"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="検証用：広告を閉じた後の4秒保護・追加の画面安定待機を無効化。以前のようにガチャ読み込み中の×を押してキャンセルする危険があるため、問題が出たらOFFに戻してください。画像の×は複数回の検出で位置を確認してから押します。"
 android:paddingBottom="10dp"/>
<Switch android:id="@+id/enableHomeRecovery"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:minHeight="50dp" android:text="HOMEで進めない時に1回だけ自動復旧する"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="HOMEで2方式失敗 → トリマのアプリ情報から強制停止・再起動を試行 → 最大3方式で再確認。設定画面が判別できなければ通常の開き直しに切り替え、他のアプリは停止しません。"
 android:paddingBottom="8dp"/>
<Button android:id="@+id/checkUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="アプリの更新を確認"/>
<TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更新確認待ち" android:textIsSelectable="true"/>
<Button android:id="@+id/openSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="アクセシビリティ設定"/>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="16dp" android:text="回収タスク・実行記録" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="今回の基盤で管理する対象は『トリマのタンク動画』のみ。HOMEの残り回数とHOME遷移に成功した入力方式を記録し、0回を2度確認した場合だけ完了として停止します。未対応の回収対象は完了扱いしません。実行は最大3時間で安全停止。"/>
<TextView android:id="@+id/collectionOverview" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:padding="10dp"
 android:text="回収タスク：実行記録なし" android:textIsSelectable="true"/>
<TextView android:id="@+id/homeExperimentInfo" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:padding="8dp"
 android:text="HOME押し方：成功した方式はまだ未記録" android:textIsSelectable="true"/>
<Button android:id="@+id/copyCollectionHistory" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:text="回収タスク・所要時間の履歴をコピー"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="画面収集・安全な自動操作" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="トリマ画面上のバーから自動開始・停止。Google Playが前面に出たら自動でトリマに復帰します。HOME紫ボタンは実画面の高さと「または」の位置から探し、学習座標・ボタン／親ACTION_CLICK・中央タップなど最大7方式を比較。HOMEからの広告遷移は入力実行とは別に確認し、結果を一括診断ZIPに記録します。広告の×を押した直後は、通信待ちやガチャ読み込みで出る一時的な×を押しません。次の報酬・ガチャ・HOME画面が3秒以上安定してから再開し、90秒間確認できなければ停止します。"/>
<Button android:id="@+id/startCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="記録・自動操作バーを表示（指タップ比較もここ）"/>
<Button android:id="@+id/stopCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="画面記録バーを終了"/>
<Button android:id="@+id/copyCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="収集ログをまとめてコピー"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="12dp" android:text="個別の画像診断（通常は上の一括共有だけでOK）" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="トリマ画面の操作バーから「画像」を押すと、ノードのない広告も画像で記録できます。自動実行中に6秒以上不明だった画面も間隔を空けて撮影。画面内の×形状候補を端末内で検出し、画像と候補座標を保存します。候補は確定したボタンではありません。保存画像は端末内のみ・最新24枚まで。内容を確認してからZIPを共有してください。"/>
<TextView android:id="@+id/visualDiagnosticsCount" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:text="画像記録：0枚"/>
<Button android:id="@+id/shareVisualDiagnostics" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:text="画像診断をZIPで共有（画像＋座標JSON）"/>
<Button android:id="@+id/copyVisualDiagnostics" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:text="画像診断の検出結果だけコピー"/>
<Button android:id="@+id/clearVisualDiagnostics" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:text="保存した画像診断を削除"/>
<Button android:id="@+id/clearCollector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="収集ログを消去"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="学習操作・復帰ログ" android:textSize="18sp" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="広告で止まったら『停止』→『学習』→閉じたい位置を指定→画面の変化を確認して『登録』。閉じる文字がクリック不可でも、広告固有の親ボタンと座標を学習できます。登録操作は必ず保存し、自動使用できる場合は『自動操作ルール』、画面の特徴が不足する場合は『学習例（保留）』として分けて表示します。学習例は原則として自動では押しません。同じ未識別の操作は1グループに集約して回数と画面の例を記録します。何度も同じ操作を教える必要はありません。ただし、以前ユーザーが登録した右上の無記名画像×について、広告の固有文字・位置・画面一致を十分確認できたものだけ自動ルールに昇格します。Google Oneの閉じるは広告SDKと表示領域を優先して照合します。ガチャ演出中の×は引き続き押さず、カード結果後の広告も識別できた場合のみ操作します。"/>
<Button android:id="@+id/copyActionHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="操作履歴をコピー"/>
<Button android:id="@+id/copyLearnedRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学習済み操作をコピー"/>
<Button android:id="@+id/clearLearnedRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学習した操作をすべて削除"/>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
 android:text="個別のHOME・広告テスト（従来版）" android:textSize="18sp"/>
<Button android:id="@+id/checkHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME判定（タップなし）"/>
<Button android:id="@+id/tapHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME判定＋1回だけタップ"/>
<Button android:id="@+id/runSequence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5秒後にHOME→広告の×を閉じる（1回）"/>
<Button android:id="@+id/stopSequence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="広告待機を停止"/>
<Button android:id="@+id/scanAd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15秒後に広告診断（タップなし）"/>
<Button android:id="@+id/scanAdTap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15秒後に広告診断＋識別した×を1回タップ"/>
<Button android:id="@+id/copyResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="診断結果をコピー"/>
<TextView android:id="@+id/debugStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="サービス未接続"/>
<TextView android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="診断待ち" android:textIsSelectable="true"/>
</LinearLayout></ScrollView>